# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agent_builder

# Redis
REDIS_URL=redis://localhost:6379

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# OAuth Providers (optional)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sandflare.io
SANDFLARE_API_KEY=your-sandflare-api-key
SANDFLARE_BASE_URL=https://api.sandflare.io

# Encryption
ENCRYPTION_KEY=your-32-character-hex-key-here

# OpenAI (optional - for LLM nodes)
OPENAI_API_KEY=

# Anthropic (optional - for Claude nodes)
ANTHROPIC_API_KEY=
