# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL 16
DATABASE_URL=postgresql://user:password@localhost:5432/pandaflow

# Redis 7 (agent bus, HITL approvals, agent memory)
REDIS_URL=redis://localhost:6379

# NextAuth session signing — generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Secrets encryption (AES-256-GCM) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key-here

# PandaStack execution backend — the app refuses to start without this.
# Get a pds_... token from https://pandastack.ai (dashboard → API Tokens),
# or set to `mock-api-key` for fully offline development without microVMs.
PANDASTACK_API_KEY=your-pandastack-api-key
PANDASTACK_API=https://api.pandastack.ai

# ── Optional ────────────────────────────────────────────────────────────────

# Skip auth entirely in local dev (single-user mode)
SKIP_AUTH=false

# OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link email sign-in (Resend)
RESEND_API_KEY=
RESEND_FROM=

# LLM providers (for AI nodes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shared secret for the external agent-scheduler cron
# (GET /api/agents/scheduler/tick with header x-scheduler-secret)
SCHEDULER_SECRET=
